<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.appcontrolepro">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppControlePro">

        <!-- =========================
             SPLASH (INICIAL)
        ========================= -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- =========================
             LOGIN / CADASTRO
        ========================= -->
        <activity android:name=".activities.LoginActivity" android:exported="false"/>
        <activity android:name=".activities.CadastroUsuarioActivity" android:exported="false"/>
        <activity android:name=".activities.CadastroTimeActivity" android:exported="false"/>

        <!-- =========================
             ESCOLHER TIME
        ========================= -->
        <activity android:name=".activities.EscolherTimeActivity" android:exported="false"/>

        <!-- =========================
             MAIN
        ========================= -->
        <activity android:name=".activities.MainActivity" android:exported="false"/>

        <!-- =========================
             JOGADORES
        ========================= -->
        <activity android:name=".activities.CadastroJogadorActivity" android:exported="false"/>

        <!-- =========================
             JOGOS
        ========================= -->
        <activity android:name=".activities.CadastroJogoActivity" android:exported="false"/>
        <activity android:name=".activities.EditarJogoActivity" android:exported="false"/>
        <activity android:name=".activities.SumulaActivity" android:exported="false"/>

        <!-- =========================
             TIME
        ========================= -->
        <activity android:name=".activities.EditarTimeActivity" android:exported="false"/>

        <!-- =========================
             PERFIL
        ========================= -->
        <activity android:name=".activities.PerfilActivity" android:exported="false"/>

    </application>

</manifest>