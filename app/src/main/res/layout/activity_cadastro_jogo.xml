<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ADVERSÁRIO -->
    <EditText
        android:id="@+id/edtAdversario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do adversário"
        android:textColor="#2E7D32"
        android:layout_marginBottom="10dp"/>

    <!-- DATA -->
    <EditText
        android:id="@+id/edtData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Selecionar data"
        android:focusable="false"
        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
        android:layout_marginBottom="10dp"
        android:textColor="#2E7D32"/>

    <!-- HORA -->
    <EditText
        android:id="@+id/edtHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Selecionar hora"
        android:focusable="false"
        android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
        android:layout_marginBottom="10dp"
        android:textColor="#2E7D32"/>

    <!-- BOTÃO -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Cadastrar Jogo"
        android:onClick="cadastrarJogo"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"/>
</LinearLayout>