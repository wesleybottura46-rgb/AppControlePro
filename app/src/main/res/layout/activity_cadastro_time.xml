<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar Time"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- IMAGEM -->
        <ImageView
            android:id="@+id/imgEmblema"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="10dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Selecionar Emblema"
            android:onClick="selecionarImagem"
            android:layout_marginBottom="15dp"/>

        <!-- NOME -->
        <EditText
            android:id="@+id/edtNomeTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="Nome do time"
            android:singleLine="false"
            android:textColor="#2E7D32"/>

        <!-- CIDADE -->
        <EditText
            android:id="@+id/edtCidade"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Cidade"
            android:layout_marginBottom="10dp"
            android:textColor="#2E7D32"/>

        <!-- ESTADO -->
        <EditText
            android:id="@+id/edtEstado"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Estado"
            android:layout_marginBottom="20dp"
            android:textColor="#2E7D32"/>

        <!-- BOTÃO -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#2E7D32"
            android:onClick="cadastrarTime"
            android:text="Salvar Time"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>