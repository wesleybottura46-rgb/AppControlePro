<?xml version="1.0" encoding="utf-8"?>

<!-- ===================================================== -->
<!-- TELA CADASTRAR TIME -->
<!-- ===================================================== -->
<!-- VISUAL LIMPO -->
<!-- SEM EMBLEMA -->
<!-- MAIS SIMÉTRICO -->
<!-- ===================================================== -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar Time"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="36dp"/>

        <!-- ================================================= -->
        <!-- NOME -->
        <!-- ================================================= -->
        <EditText
            android:id="@+id/edtNomeTime"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:hint="Nome do time"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textSize="16sp"
            android:background="#FFFFFF"/>

        <!-- ================================================= -->
        <!-- CIDADE -->
        <!-- ================================================= -->
        <EditText
            android:id="@+id/edtCidade"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:hint="Cidade"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textSize="16sp"
            android:background="#FFFFFF"/>

        <!-- ================================================= -->
        <!-- ESTADO -->
        <!-- ================================================= -->
        <EditText
            android:id="@+id/edtEstado"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="32dp"
            android:hint="Estado"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textSize="16sp"
            android:background="#FFFFFF"/>

        <!-- ================================================= -->
        <!-- BOTÃO -->
        <!-- ================================================= -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#2E7D32"
            android:onClick="cadastrarTime"
            android:text="Salvar Time"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>