<?xml version="1.0" encoding="utf-8"?>

<!-- TELA DE CADASTRO DE USUÁRIO -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Conta"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp">

            <!-- EMAIL -->
            <EditText
                android:id="@+id/edtEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="#2E7D32"
                android:textColorHint="#666666"
                android:layout_marginBottom="16dp"/>

            <!-- SENHA -->
            <EditText
                android:id="@+id/edtSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Senha (mín. 6 caracteres)"
                android:inputType="textPassword"
                android:textColor="#2E7D32"
                android:textColorHint="#666666"
                android:layout_marginBottom="20dp"/>

            <!-- BOTÃO CADASTRAR -->
            <Button
                android:id="@+id/btnCadastrarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Criar Conta"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"/>

        </LinearLayout>

        <!-- VOLTAR PARA LOGIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Já tem conta? Fazer login"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:onClick="voltarLogin"/>

    </LinearLayout>

</ScrollView>