<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caixa do Time"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <!-- CARD SALDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo Atual"
                android:textColor="#666666"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- CARD ENTRADAS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entradas"
                android:textColor="#666666"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtEntradas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- CARD SAIDAS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saídas"
                android:textColor="#666666"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtSaidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- TÍTULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movimentações"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="24dp"
            android:textColor="#000000"/>

        <!-- LISTA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMovimentacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>


        <!-- BOTÃO -->

        <Button
            android:id="@+id/btnNovaMovimentacao"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Nova Movimentação"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>



</ScrollView>