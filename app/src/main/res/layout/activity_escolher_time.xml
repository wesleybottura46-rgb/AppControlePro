<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- título -->
    <TextView
        android:id="@+id/txtTituloEscolherTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolher Time"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <!-- campo pesquisa -->
    <EditText
        android:id="@+id/edtPesquisarTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Pesquisar time"
        app:layout_constraintTop_toBottomOf="@id/txtTituloEscolherTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- spinner de times -->
    <Spinner
        android:id="@+id/spinnerTimes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisarTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- botão entrar -->
    <Button
        android:id="@+id/btnEntrarTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Entrar no Time"
        android:onClick="entrarNoTime"
        app:layout_constraintTop_toBottomOf="@id/spinnerTimes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>