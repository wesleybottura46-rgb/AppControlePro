<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F1F8F4">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título da tela -->
        <TextView
            android:id="@+id/txtTituloFinanceiro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controle Financeiro"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Campo descrição -->
        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:hint="Descrição"
            android:padding="16dp"
            android:background="@drawable/campo_verde"
            app:layout_constraintTop_toBottomOf="@id/txtTituloFinanceiro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Campo valor -->
        <EditText
            android:id="@+id/edtValor"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:hint="Valor"
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:background="@drawable/campo_verde"
            app:layout_constraintTop_toBottomOf="@id/edtDescricao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Spinner tipo -->
        <Spinner
            android:id="@+id/edtTipo"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:entries="@array/tipos_financeiro"
            android:background="@drawable/campo_verde"
            app:layout_constraintTop_toBottomOf="@id/edtValor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Botão salvar -->
        <Button
            android:id="@+id/btnSalvarLancamento"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Salvar Lançamento"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_verde"
            android:backgroundTint="@null"
            android:onClick="salvarLancamento"
            app:layout_constraintTop_toBottomOf="@id/edtTipo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Saldo atual -->
        <TextView
            android:id="@+id/txtSaldo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Saldo atual: R$ 0.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btnSalvarLancamento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>