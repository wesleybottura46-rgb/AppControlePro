<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controle Pro"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <!-- EMAIL -->
            <EditText
                android:id="@+id/edtEmailLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"
                android:textColor="#2E7D32" />

            <!-- SENHA -->
            <EditText
                android:id="@+id/edtSenhaLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp"
                android:textColor="#2E7D32" />

            <!-- CHECKBOX MANTER LOGADO -->
            <CheckBox
                android:id="@+id/checkManterLogado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manter logado"
                android:layout_marginBottom="10dp"/>

            <!-- ESQUECI SENHA -->
            <TextView
                android:id="@+id/txtEsqueciSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esqueci minha senha"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:onClick="recuperarSenha"
                android:layout_marginBottom="16dp"/>

            <!-- LOGIN -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Entrar"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:onClick="fazerLogin"/>

            <!-- CADASTRO -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Criar conta"
                android:backgroundTint="#C8E6C9"
                android:textColor="#2E7D32"
                android:onClick="abrirCadastro"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>