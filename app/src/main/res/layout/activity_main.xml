<?xml version="1.0" encoding="utf-8"?>

<!-- ===================================================== -->
<!-- TELA PRINCIPAL -->
<!-- ===================================================== -->
<!-- LAYOUT ORIGINAL -->
<!-- APENAS CORRIGIDO -->
<!-- COM TROCA DE EMBLEMA -->
<!-- ===================================================== -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#F1F8F4">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:background="#2E7D32"

        android:orientation="vertical"

        android:padding="16dp">

        <!-- ================================================= -->
        <!-- ESCUDO TIME -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imgTime"

            android:layout_width="90dp"

            android:layout_height="90dp"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="16dp"

            android:layout_marginBottom="12dp"

            android:scaleType="centerCrop"

            android:src="@mipmap/ic_launcher"

            android:background="#FFFFFF"

            android:padding="4dp"

            android:clickable="true"

            android:focusable="true"

            android:contentDescription="Escudo do time" />

        <!-- ================================================= -->
        <!-- NOME TIME -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNomeTime"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Meu Time"

            android:textSize="22sp"

            android:textStyle="bold"

            android:textColor="#FFFFFF"

            android:gravity="center"/>
    </LinearLayout>

    <!-- ================================================= -->
    <!-- BOTÕES -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:padding="10dp"

        android:orientation="horizontal">

        <!-- ================================================= -->
        <!-- NOVO JOGO -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnNovoJogo"

            android:layout_width="0dp"

            android:layout_height="50dp"

            android:layout_weight="1"

            android:backgroundTint="#2E7D32"

            android:onClick="abrirCadastroJogo"

            android:text="+ Jogo"

            android:textColor="#FFFFFF" />

        <!-- ================================================= -->
        <!-- NOVO JOGADOR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnNovoJogador"

            android:layout_width="0dp"

            android:layout_height="50dp"

            android:layout_weight="1"

            android:text="+ Jogador"

            android:onClick="abrirCadastroJogador"

            android:backgroundTint="#1B5E20"

            android:textColor="#FFFFFF"

            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- ================================================= -->
    <!-- CARD JOGOS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:background="#FFFFFF"

        android:layout_margin="10dp"

        android:padding="10dp"

        android:elevation="4dp"

        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Jogos"

            android:textSize="18sp"

            android:textStyle="bold"

            android:textColor="#000000"

            android:layout_marginBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerJogos"

            android:layout_width="match_parent"

            android:layout_height="160dp"/>
    </LinearLayout>

    <!-- ================================================= -->
    <!-- CARD ARTILHEIROS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:layout_weight="1"

        android:background="#FFFFFF"

        android:layout_margin="10dp"

        android:padding="10dp"

        android:elevation="4dp"

        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Artilheiros"

            android:textSize="18sp"

            android:textStyle="bold"

            android:textColor="#000000"

            android:layout_marginBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerJogadores"

            android:layout_width="match_parent"

            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- ================================================= -->
    <!-- TROCAR TIME -->
    <!-- ================================================= -->

    <Button
        android:layout_width="match_parent"

        android:layout_height="50dp"

        android:text="Trocar Time"

        android:onClick="trocarTime"

        android:backgroundTint="#C8E6C9"

        android:textColor="#2E7D32"/>

    <!-- ================================================= -->
    <!-- FINANCEIRO -->
    <!-- ================================================= -->

    <Button
        android:id="@+id/btnFinanceiro"

        android:layout_width="match_parent"

        android:layout_height="55dp"

        android:layout_marginTop="12dp"

        android:onClick="abriFinanceiro"

        android:text="Financeiro"

        android:textAllCaps="false"

        android:textSize="18sp" />

    <!-- ================================================= -->
    <!-- SAIR -->
    <!-- ================================================= -->

    <Button
        android:layout_width="match_parent"

        android:layout_height="55dp"

        android:text="Sair"

        android:onClick="sair"

        android:backgroundTint="#C62828"

        android:textColor="#FFFFFF"

        android:layout_marginTop="10dp"/>

</LinearLayout>