<?xml version="1.0" encoding="utf-8"?>

<!--
    Tela de perfil do usuário
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8F4"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==========================
             TÍTULO
             ========================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- ==========================
             NOVA SENHA
             ========================== -->
        <EditText
            android:textColor="#2E7D32"
            android:textColorHint="#666666"
            android:id="@+id/edtNovaSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nova senha"
            android:inputType="textPassword"
            android:padding="16dp"
            android:background="@drawable/campo_verde"
            android:layout_marginBottom="16dp"/>

        <!-- ALTERAR SENHA -->
        <Button
            android:id="@+id/btnAlterarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Alterar Senha"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_verde"
            android:backgroundTint="@null"
            android:onClick="alterarSenha"
            android:layout_marginBottom="16dp"/>

        <!-- RECUPERAR SENHA -->
        <Button
            android:id="@+id/btnRecuperarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Recuperar Senha por Email"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_verde_claro"
            android:backgroundTint="@null"
            android:onClick="recuperarSenha"
            android:layout_marginBottom="16dp"/>

        <!-- EXCLUIR CONTA -->
        <Button
            android:id="@+id/btnExcluirConta"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Excluir Conta"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_verde"
            android:backgroundTint="@null"
            android:onClick="excluirConta"
            android:layout_marginBottom="16dp"/>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Sair"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_verde_claro"
            android:backgroundTint="@null"
            android:onClick="logout"/>

    </LinearLayout>

</ScrollView>