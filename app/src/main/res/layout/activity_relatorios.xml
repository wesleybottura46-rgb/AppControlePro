<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Relatórios"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>

        <!-- CARD ARRECADAÇÃO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arrecadação do mês"
                android:textSize="16sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/txtArrecadacaoMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- CARD DESPESAS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Despesas do mês"
                android:textSize="16sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/txtDespesasMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- CARD SALDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo Atual"
                android:textSize="16sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/txtSaldoAtual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- TITULO LISTA -->





        <!-- BOTÃO PDF -->

        <Button
            android:id="@+id/btnExportar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Exportar Relatório"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>