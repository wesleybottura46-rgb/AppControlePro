<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- título -->
    <TextView
        android:id="@+id/txtTituloTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha seu perfil"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- botão dono de time -->
    <Button
        android:id="@+id/btnDonoTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sou dono de time"
        android:onClick="abrirCadastroTime"
        app:layout_constraintTop_toBottomOf="@id/txtTituloTipo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- botão jogador -->
    <Button
        android:id="@+id/btnJogador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sou jogador"
        android:onClick="abrirCadastroJogador"
        app:layout_constraintTop_toBottomOf="@id/btnDonoTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>