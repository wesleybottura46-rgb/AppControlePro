<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="16dp"

    android:background="#FFFFFF"

    android:layout_margin="8dp"

    android:elevation="3dp">

    <TextView
        android:id="@+id/txtNome"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Nome Jogador"

        android:textSize="22sp"

        android:textStyle="bold"

        android:textColor="#000000"/>

    <TextView
        android:id="@+id/txtMes"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Mês: Maio_2026"

        android:textSize="15sp"

        android:textColor="#666666"

        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/txtPago"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Pago: R$ 0"

        android:textSize="18sp"

        android:textStyle="bold"

        android:textColor="#2E7D32"

        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtStatus"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Pendente"

        android:textSize="18sp"

        android:textStyle="bold"

        android:textColor="#D32F2F"

        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/edtValorPago"

        android:layout_width="match_parent"

        android:layout_height="55dp"

        android:hint="Digite valor pago"

        android:inputType="numberDecimal"

        android:background="#EEEEEE"

        android:padding="12dp"

        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/btnSalvarPagamento"

        android:layout_width="match_parent"

        android:layout_height="50dp"

        android:text="Salvar Pagamento"

        android:textAllCaps="false"

        android:textSize="16sp"

        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/btnExcluirPagamento"

        android:layout_width="match_parent"

        android:layout_height="50dp"

        android:text="Excluir Pagamento"

        android:textAllCaps="false"

        android:textSize="16sp"

        android:layout_marginTop="10dp"

        android:backgroundTint="#D32F2F"/>

</LinearLayout>