<?xml version="1.0" encoding="utf-8"?>

<!-- ===================================================== -->
<!-- ITEM DA SÚMULA -->
<!-- ===================================================== -->
<!-- VISUAL MAIS ORGANIZADO -->
<!-- SEM ALTERAR JAVA -->
<!-- ===================================================== -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- ================================================= -->
    <!-- LINHA PRINCIPAL -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- ============================================= -->
        <!-- CHECKBOX / NOME -->
        <!-- ============================================= -->
        <CheckBox
            android:id="@+id/checkJogou"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:text="Jogador"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <!-- ============================================= -->
        <!-- ÁREA GOLS -->
        <!-- ============================================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- MENOS -->
            <Button
                android:id="@+id/btnMenosGol"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="-"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"/>

            <!-- TOTAL -->
            <TextView
                android:id="@+id/txtGols"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000"/>

            <!-- MAIS -->
            <Button
                android:id="@+id/btnMaisGol"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="+"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- ============================================= -->
        <!-- ÁREA ASSIST -->
        <!-- ============================================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- MENOS -->
            <Button
                android:id="@+id/btnMenosAssist"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="-"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"/>

            <!-- TOTAL -->
            <TextView
                android:id="@+id/txtAssist"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000"/>

            <!-- MAIS -->
            <Button
                android:id="@+id/btnMaisAssist"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="+"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>